# Required only for OpenRouter-backed query rewriting, embeddings, or reranking.
OPENROUTER_API_KEY=

# Remote components are opt-in so the deterministic offline evaluator remains reproducible.
TECHJAM_LLM_ANSWER=0
TECHJAM_LLM_INTENT=0
TECHJAM_LLM_REWRITE=0
TECHJAM_DENSE_RETRIEVAL=0
# Safe dense route: wait for accumulated evidence, score only structured
# candidates, and apply semantic fusion only after a preference override.
TECHJAM_DENSE_FILTERED=1
TECHJAM_DENSE_MIN_TURN=3
TECHJAM_DENSE_CANDIDATE_POOL_SIZE=1000
TECHJAM_DENSE_TRACKS=override
TECHJAM_RERANK=0

TECHJAM_REWRITE_MODEL=openai/gpt-5.6-luna
TECHJAM_ANSWER_MODEL=openai/gpt-5.6-luna
TECHJAM_ANSWER_CONFIDENCE_THRESHOLD=0.65
TECHJAM_INTENT_MODEL=openai/gpt-5.6-luna
TECHJAM_INTENT_CONFIDENCE_THRESHOLD=0.65
TECHJAM_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
TECHJAM_RERANK_MODEL=qwen/qwen3-reranker-8b
TECHJAM_EMBEDDING_DIMENSIONS=512
# Optional explicit path to the portable prebuilt 50,000-product index.
TECHJAM_SEMANTIC_INDEX_PATH=artifacts/semantic_cache/catalog_qwen3_embedding_8b_512_v1.npz
TECHJAM_EMBEDDING_BATCH_SIZE=64
TECHJAM_EMBEDDING_WORKERS=2
TECHJAM_EMBEDDING_JOB_RETRIES=8
TECHJAM_EMBEDDING_RETRY_BASE_SECONDS=2
TECHJAM_LEXICAL_FUSION_WEIGHT=50
TECHJAM_DENSE_IDENTITY_FUSION_WEIGHT=1
TECHJAM_DENSE_ATTRIBUTE_FUSION_WEIGHT=1
TECHJAM_RERANK_DEPTH=50
TECHJAM_RERANK_BASE_FUSION_WEIGHT=25
TECHJAM_RERANK_MODEL_FUSION_WEIGHT=1

# Progressive opening results. ON by default -- turns 1-2 expose only rank 1,
# then turn 3 onward exposes the requested Top K (normally 10). This preserves
# early availability while preventing weak opening rankings from converting at
# ranks 2-10. Set EARLY_RECOMMENDATION_LIMIT=0 for the previous silent policy.
# See docs/suppression_results.md.
# Do not raise TURNS above 2 without re-reading that document: past the point
# where the customer runs out of information the hit rate collapses.
TECHJAM_SUPPRESSION=1
TECHJAM_SUPPRESSION_TURNS=2
TECHJAM_SUPPRESSION_MAX_TURNS=2
TECHJAM_SUPPRESSION_RESERVE_TURNS=3
TECHJAM_EARLY_RECOMMENDATION_LIMIT=1

# Dual-track intent routing. Buying, browsing and post-override sessions use
# different retrieval weightings. 0 collapses every track to the neutral
# weighting and reproduces the pre-routing score exactly.
TECHJAM_INTENT_ROUTING_SCALE=1.0

# Recency weighting on accumulated constraints (1.0 = every slot equal).
TECHJAM_SLOT_DECAY=0.9

# Weight kept on a preference the customer retracted via an intent override.
# It never enters the live intersection or coverage denominator.
TECHJAM_RETRACTED_WEIGHT=0.25

# Structured lexical refinements. Exact taxonomy suffix matching uses the
# catalog hierarchy rather than loose category-token overlap. Retracted context
# is a separate low-weight RRF route, never an active requirement.
TECHJAM_EXACT_CATEGORY_SUFFIX_BONUS=0.5
TECHJAM_RETRACTED_CONTEXT_WEIGHT=1.0

# Optional catalog-provenance reranker for post-override conversations. It uses
# ordered salient metadata and constraint sources/turns, never evaluator code or
# a target id. Keep off for the conservative default; see docs/override_likelihood_results.md.
TECHJAM_OVERRIDE_LIKELIHOOD=0
